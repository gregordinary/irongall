# Tokens of the armor grammar, so the fuzzer reaches past the header line
# without having to discover it a byte at a time.
"-----BEGIN "
"-----END "
"-----"
"PGP MESSAGE"
"PGP PUBLIC KEY BLOCK"
"PGP PRIVATE KEY BLOCK"
"PGP SIGNATURE"
"PGP SIGNED MESSAGE"
"Comment: "
"Hash: "
":"
"="
"=="
"\x0a"
"\x0d\x0a"
"\x0a\x0a"
"- "
"Hash: SHA256"
"SHA512"
","
"\x09"
"\x0d"
